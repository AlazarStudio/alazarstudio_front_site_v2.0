RewriteEngine On

# Канонизация хоста и схемы: только https://xn--80aaa1as7a.xn--p1ai (301, сохраняем путь и query)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^(www\.)?alazarstudio\.ru$ [NC,OR]
RewriteCond %{HTTP_HOST} ^www\.xn--80aaa1as7a\.xn--p1ai$ [NC]
RewriteRule ^(.*)$ https://xn--80aaa1as7a.xn--p1ai/$1 [R=301,L,QSA]

# Legacy detail URL -> canonical detail URL
RewriteRule ^case/(.+)$ /cases/$1 [R=301,L,QSA,NC]
RewriteRule ^new/(.+)$ /news/$1 [R=301,L,QSA,NC]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]